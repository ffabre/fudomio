# SQLite is the default. Leave this as sqlite for local development.
DATABASE_DIALECT=sqlite

# Optional SQLite file. Defaults to data/fudo.sqlite.
# DATABASE_URL=file:data/fudo.sqlite

# To use Postgres instead, start it with `docker compose up -d` and switch:
# DATABASE_DIALECT=postgres
# DATABASE_URL=postgres://fudo:fudo@localhost:5432/fudo
